# Config options for all of the below: https://docs.photoprism.app/getting-started/config-options/

# Host storage locations. These must be absolute paths — stay-go renders this
# project into a private cache dir before each run, so a relative "./storage"
# would resolve inside the cache and be lost on the next run.
PHOTOPRISM_ORIGINALS=/storage/dropbox/Dropbox/Photos
PHOTOPRISM_STORAGE=/storage/apps/photoprism/storage
PHOTOPRISM_DATABASE=/storage/apps/photoprism/database

TZ=America/Phoenix

# Server URL in the format "http(s)://domain.name(:port)/(path)"
PHOTOPRISM_SITE_URL=http://192.168.1.50:2342/

# Initial admin login. The password is only applied when the database is first
# created; change it in the UI afterwards.
PHOTOPRISM_ADMIN_USER=admin
PHOTOPRISM_ADMIN_PASSWORD=${secrets.photoprism.admin_password}

# MariaDB credentials. PHOTOPRISM_DATABASE_PASSWORD is also MARIADB_PASSWORD for
# the photoprism database user — the compose file wires the same value to both.
PHOTOPRISM_DATABASE_PASSWORD=${secrets.photoprism.db_password}
MARIADB_ROOT_PASSWORD=${secrets.photoprism.db_root_password}
