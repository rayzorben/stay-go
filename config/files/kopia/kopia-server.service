# Managed by stay-go — see config/hosts/orohost.yaml (Backups: Kopia → Google Drive).
#
# The Kopia server is the backup engine and the UI in one process: it runs every
# source's scheduled snapshot, retention and repository maintenance, serves
# the web UI used to browse and restore, and is the repository server other
# machines (cachygram) back up through. It listens on loopback only;
# `tailscale serve` forwards raw TCP from the tailnet to it, so it is reachable
# from the tailnet and nowhere else.
#
# It terminates TLS itself, with orohost's real ts.net certificate: clients
# talk gRPC, which needs HTTP/2, and Kopia speaks only HTTP/1.1 without TLS
# (--insecure), which an HTTPS proxy in front cannot fix. `tailscale cert`
# returns the cached certificate and renews it when it nears expiry, and the
# daily restart below re-runs it. A failure (tailscaled not up yet) keeps the
# files already there.
#
# Runs as root: /storage/apps holds files owned by a dozen container uids, and the
# before-snapshot action has to be able to `zfs snapshot`.

[Unit]
Description=Kopia backup server (orohost → Google Drive)
Documentation=https://kopia.io/docs/
Wants=network-online.target zfs-mount.service
After=network-online.target zfs-mount.service tailscaled.service

[Service]
Type=simple
EnvironmentFile=/etc/kopia/kopia.env
ExecStartPre=-/usr/bin/tailscale cert --cert-file=/etc/kopia/tls.crt --key-file=/etc/kopia/tls.key orohost.tawny-tailor.ts.net
ExecStart=/usr/bin/kopia server start --address=https://127.0.0.1:51515 --tls-cert-file=/etc/kopia/tls.crt --tls-key-file=/etc/kopia/tls.key
Restart=always
RestartSec=30
# Restart daily. The rclone child the server talks to Google Drive through
# wore out after a week's uptime (dropped every request, 2026-10-17 to 10-27)
# and Kopia never restarts it; a restart starts a fresh one. An upload cut off
# here resumes from its last checkpoint. kopia-watchdog catches it in between.
RuntimeMaxSec=1d
# Hashing and zstd yield the CPU to frigate and the other containers. (No IOSchedulingClass:
# ZFS has its own I/O scheduler and ignores the kernel's ioprio.)
Nice=10

[Install]
WantedBy=multi-user.target
