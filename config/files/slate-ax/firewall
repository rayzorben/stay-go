config zone 'netbond007'
	option name 'netbond007'
	list device 'net-bond-007'
	option input 'REJECT'
	option output 'ACCEPT'
	option forward 'REJECT'
	option masq '1'
	option mtu_fix '1'

config forwarding 'netbond007_lan'
	option src 'lan'
	option dest 'netbond007'

