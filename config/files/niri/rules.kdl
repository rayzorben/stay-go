// Workspaces are named dynamically by wintelligent (P-BRW, S-DEV, M-OFF, …),
// so there are no static `workspace` declarations here. Declaring one would
// pin it permanently and stop it being reclaimed when it empties.
// See ~/Dropbox/PC/development/wintelligent.

window-rule {
    match title="RemoteApp Marker Window"
    open-on-workspace "9"
}

window-rule {
    match app-id="satty"
    open-floating true
}

window-rule {
    match app-id="org.gnome.Calculator"
    open-floating true

    default-column-width { fixed 480; }
    default-window-height { fixed 640; }

    shadow {
        on
    }
}

window-rule {
    match title="FreeRDP"
    match app-id="wlfreerdp"
    open-floating true
}

// Workspace routing for these now lives in wintelligent's config.toml — the
// org markers below (- SED -, -sedanos$, - VIS -, - SSI -) are matched there.
// Only the sizing behaviour is kept here.
window-rule {
    match app-id="firefox$"
    open-maximized true
}

window-rule {
    match title="- SED -"
    match app-id="-sedanos$"
    open-maximized true
}

window-rule {
    match title="- VIS -"
    match title="- OCS -"
    match app-id="-visionet$"
    open-maximized true
}

window-rule {
    match title="- SSI -"
    open-maximized true
}

layer-rule {
    match namespace="dms:spotlight"

    // Properties that apply continuously.
    opacity 0.9
    block-out-from "screencast"
}
